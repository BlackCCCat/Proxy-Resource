@@ -0,0 +1,36 @@
+/** Keyword rules ported from ElyDemiurge/Loon-Plugins/bilibili.
+ * Keep matching local and synchronous on response hot paths.
+ */
+export interface KeywordConfig {
+    titleKeywords: string[];
+    blockedUps: string[];
+    dynamicKeywords: string[];
+    searchResultKeywords: string[];
+}
+
+function parseTerms(value: unknown): string[] {
+    if (typeof value !== 'string') return [];
+    return [...new Set(value.split(/[,|;，；\n\r]+/).map(part => part.trim().toLocaleLowerCase()).filter(Boolean))];
+}
+
+export function parseKeywordConfig(argument: unknown): KeywordConfig {
+    const input = argument && typeof argument === 'object' ? argument as Record<string, unknown> : {};
+    return {
+        titleKeywords: parseTerms(input.titleKeywords),
+        blockedUps: parseTerms(input.blockedUps).map(up => up.replace(/^(up主|频道)[:：]/i, '').replace(/\s+/g, ' ').trim()),
+        dynamicKeywords: parseTerms(input.dynamicKeywords),
+        searchResultKeywords: parseTerms(input.searchResultKeywords),
+    };
+}
+
+export function containsKeyword(value: unknown, keywords: string[]): boolean {
+    return typeof value === 'string' && keywords.length > 0 &&
+        keywords.some(keyword => value.toLocaleLowerCase().includes(keyword));
+}
+
+export function matchesVideo(title: unknown, up: unknown, config: KeywordConfig): boolean {
+    if (containsKeyword(title, config.titleKeywords)) return true;
+    if (typeof up !== 'string' || !config.blockedUps.length) return false;
+    const normalized = up.replace(/^(UP主|频道)[:：]/, '').replace(/\s+/g, ' ').trim().toLocaleLowerCase();
+    return config.blockedUps.includes(normalized);
+}
