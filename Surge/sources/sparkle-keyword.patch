index 0000000..683aebb
--- /dev/null
+++ b/src/script/bilibili/protobuf/keyword-filter.ts
@@ -0,0 +1,280 @@
+import { containsKeyword, KeywordConfig, matchesVideo } from '../keyword';
+
+interface Field {
+    no: number;
+    wire: number;
+    value: Uint8Array;
+    raw: Uint8Array;
+}
+
+const decoder = new TextDecoder('utf-8', { fatal: true });
+const looseDecoder = new TextDecoder('utf-8');
+
+function varint(bytes: Uint8Array, start: number): [number, number] | null {
+    let value = 0;
+    let multiplier = 1;
+    for (let i = start; i < bytes.length && i < start + 10; i++) {
+        const byte = bytes[i];
+        value += (byte & 0x7f) * multiplier;
+        if (!Number.isSafeInteger(value)) return null;
+        if (!(byte & 0x80)) return [value, i + 1];
+        multiplier *= 128;
+    }
+    return null;
+}
+
+function fields(bytes: Uint8Array): Field[] | null {
+    const result: Field[] = [];
+    for (let offset = 0; offset < bytes.length;) {
+        const start = offset;
+        const tag = varint(bytes, offset);
+        if (!tag) return null;
+        const no = Math.floor(tag[0] / 8);
+        const wire = tag[0] % 8;
+        if (!no || no > 536870911) return null;
+        offset = tag[1];
+        let valueStart = offset;
+        let end = offset;
+        if (wire === 0) {
+            const value = varint(bytes, offset);
+            if (!value) return null;
+            end = value[1];
+        } else if (wire === 1) {
+            end = offset + 8;
+        } else if (wire === 2) {
+            const length = varint(bytes, offset);
+            if (!length) return null;
+            valueStart = length[1];
+            end = valueStart + length[0];
+        } else if (wire === 5) {
+            end = offset + 4;
+        } else {
+            return null;
+        }
+        if (end > bytes.length) return null;
+        result.push({ no, wire, value: bytes.subarray(valueStart, end), raw: bytes.subarray(start, end) });
+        offset = end;
+    }
+    return result;
+}
+
+function text(bytes: Uint8Array): string {
+    if (!bytes.length || bytes.length > 2048) return '';
+    try {
+        const value = decoder.decode(bytes).replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
+        return /[\x00-\x1f\ufffd]/.test(value) ? '' : value;
+    } catch {
+        return '';
+    }
+}
+
+function strings(message: Uint8Array, no: number): string[] {
+    return (fields(message) || []).filter(field => field.no === no && field.wire === 2)
+        .map(field => text(field.value)).filter(Boolean);
+}
+
+function nested(message: Uint8Array, no: number): Uint8Array | undefined {
+    return fields(message)?.find(field => field.no === no && field.wire === 2)?.value;
+}
+
+function textEntries(message: Uint8Array, maxDepth = 8): { path: string; value: string }[] {
+    const result: { path: string; value: string }[] = [];
+    function walk(bytes: Uint8Array, path: number[], depth: number): void {
+        if (depth > maxDepth) return;
+        const parsed = fields(bytes);
+        if (!parsed) return;
+        for (const field of parsed) {
+            if (field.wire !== 2 || !field.value.length) continue;
+            const nextPath = [...path, field.no];
+            const value = text(field.value);
+            if (value) result.push({ path: nextPath.join('.'), value });
+            if (depth < maxDepth && field.value.length > 2) walk(field.value, nextPath, depth + 1);
+        }
+    }
+    walk(message, [], 0);
+    return result;
+}
+
+function combine(chunks: Uint8Array[]): Uint8Array {
+    const size = chunks.reduce((sum, bytes) => sum + bytes.length, 0);
+    const result = new Uint8Array(size);
+    let offset = 0;
+    for (const bytes of chunks) {
+        result.set(bytes, offset);
+        offset += bytes.length;
+    }
+    return result;
+}
+
+function encodedVarint(value: number): Uint8Array {
+    const output: number[] = [];
+    do {
+        let byte = value % 128;
+        value = Math.floor(value / 128);
+        if (value) byte |= 0x80;
+        output.push(byte);
+    } while (value);
+    return Uint8Array.from(output);
+}
+
+function replaceField(field: Field, value: Uint8Array): Uint8Array {
+    return combine([encodedVarint(field.no * 8 + 2), encodedVarint(value.length), value]);
+}
+
+function filterRepeated(message: Uint8Array, no: number, remove: (value: Uint8Array) => boolean): Uint8Array {
+    const parsed = fields(message);
+    if (!parsed) return message;
+    const chunks: Uint8Array[] = [];
+    let changed = false;
+    for (const field of parsed) {
+        if (field.no === no && field.wire === 2 && remove(field.value)) {
+            changed = true;
+        } else {
+            chunks.push(field.raw);
+        }
+    }
+    return changed ? combine(chunks) : message;
+}
+
+function firstPath(entries: { path: string; value: string }[], paths: string[]): string {
+    for (const path of paths) {
+        const value = entries.find(entry => entry.path === path || entry.path.endsWith(`.${path}`))?.value;
+        if (value) return value;
+    }
+    return '';
+}
+
+function firstReadable(entries: { path: string; value: string }[]): string {
+    return entries.find(entry => entry.value.length <= 120 &&
+        !/^(?:https?:|bilibili:|UP主[:：]|[\d\s·]+$)/i.test(entry.value))?.value || '';
+}
+
+function popularMatches(card: Uint8Array, config: KeywordConfig): boolean {
+    const cover = nested(card, 1);
+    if (!cover) return false;
+    const base = nested(cover, 1);
+    const titles = base ? strings(base, 6) : [];
+    const ups = strings(cover, 5);
+    const share = base ? (fields(base) || []).filter(field => field.no === 18 && field.wire === 2) : [];
+    for (const section of share) {
+        for (const item of (fields(section.value) || []).filter(field => field.no === 1 && field.wire === 2)) {
+            titles.push(...strings(item.value, 1));
+            ups.push(...strings(item.value, 8));
+        }
+    }
+    return titles.some(title => matchesVideo(title, '', config)) || ups.some(up => matchesVideo('', up, config));
+}
+
+export function filterPopular(message: Uint8Array, config: KeywordConfig): Uint8Array {
+    if (!config.titleKeywords.length && !config.blockedUps.length) return message;
+    return filterRepeated(message, 1, card => popularMatches(card, config));
+}
+
+export function filterDynamic(message: Uint8Array, config: KeywordConfig): Uint8Array {
+    if (!config.dynamicKeywords.length) return message;
+    const parsed = fields(message);
+    if (!parsed) return message;
+    let changed = false;
+    const chunks = parsed.map(field => {
+        if (field.no !== 1 || field.wire !== 2) return field.raw;
+        const next = filterRepeated(field.value, 1, item =>
+            textEntries(item).some(entry => containsKeyword(entry.value, config.dynamicKeywords)) ||
+            (item.length > 2048 && containsKeyword(looseDecoder.decode(item), config.dynamicKeywords)));
+        if (next === field.value) return field.raw;
+        changed = true;
+        return replaceField(field, next);
+    });
+    return changed ? combine(chunks) : message;
+}
+
+function relatedMatches(card: Uint8Array, config: KeywordConfig): boolean {
+    const entries = textEntries(card);
+    const title = firstReadable(entries);
+    const ups = entries.filter(entry => entry.path.endsWith('12.11.3'))
+        .map(entry => entry.value);
+    for (const entry of entries) {
+        const match = entry.value.match(/^UP主[:：]\s*(.+)$/);
+        if (match) ups.push(match[1]);
+    }
+    return matchesVideo(title, '', config) || ups.some(up => matchesVideo('', up, config));
+}
+
+export function filterRelatesFeed(message: Uint8Array, config: KeywordConfig): Uint8Array {
+    if (!config.titleKeywords.length && !config.blockedUps.length) return message;
+    return filterRepeated(message, 1, card => relatedMatches(card, config));
+}
+
+export function filterView(message: Uint8Array, config: KeywordConfig): Uint8Array {
+    if (!config.titleKeywords.length && !config.blockedUps.length) return message;
+    function walk(bytes: Uint8Array, path: number[], depth: number): Uint8Array {
+        if (depth > 12) return bytes;
+        const parsed = fields(bytes);
+        if (!parsed) return bytes;
+        let changed = false;
+        const chunks: Uint8Array[] = [];
+        const isRelates = path.join('.') === '5.1.2.2.22' || path.join('.') === '2.1.22';
+        for (const field of parsed) {
+            if (field.wire !== 2 || !field.value.length) {
+                chunks.push(field.raw);
+                continue;
+            }
+            if (isRelates && field.no === 1 && relatedMatches(field.value, config)) {
+                changed = true;
+                continue;
+            }
+            const next = walk(field.value, [...path, field.no], depth + 1);
+            if (next !== field.value) changed = true;
+            chunks.push(next === field.value ? field.raw : replaceField(field, next));
+        }
+        return changed ? combine(chunks) : bytes;
+    }
+    return walk(message, [], 0);
+}
+
+function ipadRelatedMatches(card: Uint8Array, config: KeywordConfig): boolean {
+    const titles = strings(card, 3);
+    const owner = nested(card, 4);
+    const ups = owner ? strings(owner, 2) : [];
+    return titles.some(title => matchesVideo(title, '', config)) || ups.some(up => matchesVideo('', up, config));
+}
+
+export function filterIpadView(message: Uint8Array, config: KeywordConfig): Uint8Array {
+    if (!config.titleKeywords.length && !config.blockedUps.length) return message;
+    return filterRepeated(message, 10, card => ipadRelatedMatches(card, config));
+}
+
+export function filterIpadRelatesFeed(message: Uint8Array, config: KeywordConfig): Uint8Array {
+    if (!config.titleKeywords.length && !config.blockedUps.length) return message;
+    return filterRepeated(message, 1, card => ipadRelatedMatches(card, config));
+}
+
+function searchMatches(item: Uint8Array, config: KeywordConfig): boolean {
+    const entries = textEntries(item);
+    // Match the same readable Chinese text scope as the Loon SearchAll handler.
+    if (entries.some(entry => /[\u4e00-\u9fff]/.test(entry.value) &&
+        !/[\x00-\x08\x0e-\x1f\ufffd]/.test(entry.value) &&
+        containsKeyword(entry.value, config.searchResultKeywords))) return true;
+    if (!config.titleKeywords.length && !config.blockedUps.length) return false;
+    const types = [...strings(item, 2), ...strings(item, 3), ...strings(item, 4)];
+    const metadata = strings(item, 63);
+    for (const value of metadata) {
+        try { types.push(String((JSON.parse(value) as { type?: string }).type || '')); } catch { /* Ignore malformed metadata. */ }
+    }
+    const isVideo = types.some(type => /^(?:video|av)$/i.test(type));
+    const title = isVideo ? firstPath(entries, ['37.1', '42.1', '10.1', '52.2.1', '23.14.2', '23.1', '23.8', '44.2.1', '23.21.1']) : '';
+    const ups = entries.filter(entry => ['37.10', '23.1', '23.14', '23.14.2', '23.32']
+        .some(path => entry.path === path || entry.path.endsWith(`.${path}`)))
+        .map(entry => entry.value);
+    return matchesVideo(title, '', config) || ups.some(up => matchesVideo('', up, config));
+}
+
+export function filterSearch(message: Uint8Array, config: KeywordConfig): Uint8Array {
+    if (!config.searchResultKeywords.length && !config.titleKeywords.length && !config.blockedUps.length) return message;
+    return filterRepeated(message, 4, item => searchMatches(item, config));
+}
+
+export function filterSuggest(message: Uint8Array, config: KeywordConfig): Uint8Array {
+    if (!config.searchResultKeywords.length) return message;
+    return filterRepeated(message, 2, suggestion => textEntries(suggestion, 4)
+        .some(entry => containsKeyword(entry.value, config.searchResultKeywords)));
+}
